# Credentials for the Anthropic API.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_WORKSPACE_ID=replace-with-your-anthropic-workspace-id
ANTHROPIC_MODEL=claude-haiku-4-5

# Host ports. Change these if they are already in use.
LANGGRAPH_PORT=8000
OPEN_WEBUI_PORT=3000
